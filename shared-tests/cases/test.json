        "expected_exit_code": 1
    },
    {
        "name": "neq_true",
        "args": ["a", "!=", "b"],
        "expected_exit_code": 0
    },
    {
        "name": "num_eq_true",
        "args": ["5", "-eq", "5"],
        "expected_exit_code": 0
    },
    {
        "name": "num_eq_false",
        "args": ["5", "-eq", "6"],
        "expected_exit_code": 1
    },
    {
        "name": "num_lt_true",
        "args": ["3", "-lt", "5"],
        "expected_exit_code": 0
    },
    {
        "name": "num_lt_false",
        "args": ["5", "-lt", "3"],
        "expected_exit_code": 1
    },
    {
        "name": "num_gt_true",
        "args": ["7", "-gt", "2"],
        "expected_exit_code": 0
    },
    {
        "name": "num_le_true",
        "args": ["3", "-le", "3"],
        "expected_exit_code": 0
    },
    {
        "name": "num_ge_true",
        "args": ["5", "-ge", "5"],
        "expected_exit_code": 0
    },
    {
        "name": "not_empty",
        "args": ["!", ""],
        "expected_exit_code": 0
    },
    {
        "name": "bracket_form_true",
        "args": ["[", "hello", "]"],
        "expected_exit_code": 0
    },
    {
        "name": "bracket_form_false",
        "args": ["[", "", "]"],
